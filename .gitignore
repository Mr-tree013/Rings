# Python
.venv/
__pycache__/
*.py[cod]
*.egg-info/
build/
dist/

# Tooling caches
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
coverage.xml
htmlcov/

# Secrets and credential material — never commit
.env
.env.*
secrets/
*.pem
*.key

# Runtime state (lives in ~/.local/share/growing-assistant, never in the repo)
state/
*.db
*.sqlite
*.sqlite3

# Personal Vault must stay physically outside the repository (ADR-0004)
vault/

# Editors and OS noise
.DS_Store
Thumbs.db
.vscode/
.idea/
*.swp

